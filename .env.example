# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev default)
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/phishguard

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── CTI API Keys ──────────────────────────────────────────────────────────────
# Leave empty → CTI_MOCK=true is used automatically (no real lookups)
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# true  = use mock adapters (default, no keys needed)
# false = use live CTI APIs (requires keys above)
CTI_MOCK=true

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODEL_PATH=ml/models/artifacts/phishguard_model.joblib

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list; extension origin added automatically
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
